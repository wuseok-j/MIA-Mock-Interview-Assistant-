# 이 파일을 복사해 루트 .env 로 만들고 GEMINI_API_KEY에 키를 입력하세요.
# .env 는 Git에서 제외됩니다. 프론트엔드 VITE_* 변수에 API 키를 넣지 마세요.
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# 진행·평가 모델 후보. 평가 API 연동은 아직 미구현입니다.
LLM_MODEL_FAST=gemini-3.1-flash-lite
LLM_MODEL_SMART=gemini-3.1-flash-lite

# 기존 Claude 코드용 변수. 여기에 Gemini 키를 넣지 마세요.
# 현재 Gemini 어댑터에서는 아래 변수를 사용하지 않습니다.
# GEMINI_API_KEY가 비어 있거나 LLM_PROVIDER=mock이면 오프라인으로 동작합니다.
LLM_API_KEY=

# 비용 계산용: 0은 미설정입니다. 무료라는 뜻이 아닙니다.
# 공식 가격표에서 사용하는 모델의 100만 토큰당 달러 가격을 확인해 입력하세요.
PRICE_FAST_INPUT_PER_M=0
PRICE_FAST_OUTPUT_PER_M=0
USD_TO_KRW=1400

# 운영자 CMS(/admin) 접속 비밀번호. 비워 두면 운영자 기능이 꺼집니다.
# 길고 추측하기 어려운 값으로 정하고, 팀 단톡 등에 그대로 올리지 마세요.
ADMIN_TOKEN=
